<IfModule mod_rewrite.c>
    RewriteEngine On

    # Defense-in-depth: Mitigate PHP2Shell (CVE-2026-109618 / CVE-2026-109619)
    # UniAlloc REST API is 100% JSON-based and never accepts multipart file uploads.
    # Reject multipart/form-data before reaching the PHP interpreter.
    RewriteCond %{REQUEST_METHOD} ^(POST|PUT|PATCH) [NC]
    RewriteCond %{HTTP:Content-Type} multipart/form-data [NC]
    RewriteRule ^ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
