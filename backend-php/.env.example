# ============================================================
# UniAlloc — backend environment template
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit real secrets.
# ============================================================

APP_NAME=UniAlloc
APP_URL=http://localhost:8000
# Set false in production: hides raw DB/exception messages from API responses.
APP_DEBUG=false

# REQUIRED. Generate with:  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
# Access token lifetime in minutes (480 = 8 hours).
JWT_TTL=480

# REQUIRED. AES-256-GCM key encrypting TOTP secrets at rest. Same generator as above.
# Changing this invalidates every enrolled authenticator.
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uniAlloc_db
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# Restrict student self-registration to one domain, e.g. university.edu.
# Leave blank to allow any domain.
REGISTRATION_EMAIL_DOMAIN=

OVERLOAD_THRESHOLD_PCT=90
